from tkinter import *

ventana = Tk()

ventana.title('Ventana de MOUSA')

ventana.config(bg='black')

ventana.iconbitmap('icono.ico')


superior = Frame(ventana, width=700, height=700, bg='white', bd=3, relief='raised', cursor='hand2')
superior.place(x=15, y=15)

izquierda = Frame(ventana, width=300, height=300, bg='white', bd=4, relief='sunken', cursor='hand2')
