derecha = Frame(ventana, width=300, height=300, bg='white', bd=2, relief='sunken', cursor='hand2')
derecha.place(x=335, y=150)


Label(superior, text='Ventana de MOUSA', bg='white', fg='black', font=('Arial', 17, 'bold')).place(x=20, y=20)

Label(superior, text='CUATRO COLORES!', bg='black', fg='white', font=('Arial', 11)).place(x=20, y=65)


Label(izquierda, text='Amarillo', bg='yellow', fg='black', font=('Arial', 13, 'bold')).place(x=40, y=20)

Label(izquierda, text= 'Rojo', bg='red', fg='black', font=('Arial', 13, 'bold')).place(x=60, y=200)


Label(derecha, text='Verde', bg='green', fg='black', font=('Arial', 13, 'bold')).place(x=50, y=20)

Label(derecha, text='Azul', bg='blue', fg='black', font=('Arial', 13, 'bold')).place(x=60, y=200)



